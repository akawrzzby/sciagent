# ---------------------------------------------------------------------------
# SciAgent edge Nginx template (for the "edge" deployment topology).
#
# Difference to deploy/nginx.conf: the API upstream is not a compose service
# but a remote vLLM/backend host, so it is injected through ${API_UPSTREAM}.
#
#   docker run --rm -v ...:/etc/nginx/templates/default.conf.template:ro \
#              -e API_UPSTREAM=http://10.0.0.1:9000 nginx:alpine
#
# The official nginx image runs envsubst over /etc/nginx/templates/*.template
# and writes the result to /etc/nginx/conf.d/.
# ---------------------------------------------------------------------------

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 论文 PDF 上传（含 541 页大文件）
    client_max_body_size 200M;
    client_body_timeout 300s;
    send_timeout 3600s;

    # ---- gzip -----------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml;

    # ---- static assets ---------------------------------------------------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ---- SPA history routing ---------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---- API (SSE) --------------------------------------------------------
    location /api/ {
        proxy_pass ${API_UPSTREAM};

        # ===== SSE 关键配置 =====
        # /api/rag/ask 与 /api/rag/sessions/{id}/events 是 text/event-stream
        # 长连接。Nginx 默认缓冲上游响应，一旦缓冲，前端拿到的就是"攒完一次性
        # 吐"，token 级流式输出会完全失效。所以必须关闭缓冲并保持 HTTP/1.1。
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        gzip off;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 大 PDF 上传直接流式转发，不先落盘到 Nginx
        proxy_request_buffering off;
        proxy_connect_timeout 60s;
        proxy_intercept_errors off;
    }
}
