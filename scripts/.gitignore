# Local one-off diagnostics (not part of the public repository).
#
# These scripts were used while chasing the foreign-key bug and the
# PyMuPDF table-detection race.  They are kept locally for reference; the
# reusable versions that *are* part of the repo live next to this file.

_*.sh
probe_range.py
check_doc_name.py
repro_fk.py
cf_state.sh
db_state.sh
host_load.sh
lib_state.sh
log_summary.sh
log_tail.sh
status_all.sh
tunnel_status.sh
check_authors.py
dump_metadata.py
probe_author_band.py
seed_one.sh
probe_audit.py
probe_thinking.py

# Credential / network probes -- these read ~/.git-credentials and must never
# become part of the public repository.
probe_api.py
probe_cred.py
probe_github.py

# One-off host diagnostics (Docker Desktop / WSL2 / VHDX on the author's
# Windows machine).  Kept locally for reference.
diag_vhd.ps1
diag_volumes.ps1
diag_wsl2.ps1
reset_docker_wsl.ps1
probe_vhd.txt

# Ad-hoc orchestration helpers used to chain long server-side runs.
chain_ab.sh
chain_after_suite.sh
diag_server.sh

# Scratch analysis helpers.
inspect_eval_shape.py
which_papers.py

# One-off diagnostics of the reader rewrite (block classification, table
# detection, caption matching).  Kept locally for reference.
_diag_*.py

# One-off diagnostics of the formula rework (printed rows, script recovery,
# the state of a running deployment) and the page renders they produced.
_check_*.py
_render_page.py
_*.png

# One-off maintenance helpers that touch the database of a running deployment.
_clear_translations.py

# One-off probes used to refresh the numbers in the technical report after the
# corpus rebuild (per-paper counts, graph size, contradiction output), the
# encoding/recovery helpers, and the runners for the re-evaluation rounds.
# The reusable versions of the same measurements are eval_rag.py /
# eval_retrieval.py / run_eval_suite.sh.
#
# Rather than listing every new scratch script, ignore the whole `_*` family:
# the convention in this directory is that a leading underscore means "local
# one-off, not part of the repository", and nothing tracked starts with one.
_*.py
_*.sh
_*.png
_*.txt
_*.js
