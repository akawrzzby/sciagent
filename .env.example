# ---------------------------------------------------------------------------
# SciAgent – environment configuration template
#
# Copy to `.env` and adjust.  NEVER commit the real `.env` file: it may contain
# API keys.  All values below are safe defaults for the competition setup.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- application
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
# Comma separated CORS origins ("*" allows all).
CORS_ORIGINS=*

# ------------------------------------------------------------------- storage
# Directory holding uploaded PDFs, rendered page images and parse artefacts.
DATA_DIR=./data
# SQLite metadata store (leave empty to use <DATA_DIR>/sciagent.db).
# DATABASE_URL=sqlite+aiosqlite:///./data/sciagent.db
# Vector index directory (one .npy matrix per paper).
INDEX_DIR=./data/index

# ----------------------------------------------------------------------- llm
# OpenAI-compatible endpoint of the local vLLM server (Qwen3.8-27B).
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen3.8-27B
# Optional: only needed when the endpoint requires authentication.
# LLM_API_KEY=
LLM_TIMEOUT=300
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# ----------------------------------------------------------------- embedding
# Dense retriever (multilingual, 1024-dim) and cross-encoder reranker.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=512
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true
RERANKER_MAX_PASSAGES=24

# ---------------------------------------------------------------- retrieval
RETRIEVE_TOP_K_SPARSE=40
RETRIEVE_TOP_K_DENSE=40
RETRIEVE_TOP_K_FINAL=8

# ------------------------------------------------------------------- parsing
# DPI used when rasterising pages for OCR / formula transcription.
RENDER_DPI=150
PARSE_WORKERS=8
# 0 = unlimited; set a small number for smoke tests.
PARSE_MAX_PAGES=0

# --------------------------------------------------------------------- agent
AGENT_MAX_STEPS=8
AGENT_MAX_PARALLEL_TOOLS=4
AUDIT_DIR=./data/audit

# ------------------------------------------------------------------ security
# When API_KEY is set, clients must send the header `X-API-Key`.
# API_KEY=
REVIEWER_USER=reviewer
# REVIEWER_PASSWORD=

# ----------------------------------------------------------------- frontend
# Directory with the built frontend (frontend/dist).  When it is set, the same
# process serves the SPA and the API, so a public demo needs only one URL.
# Leave empty to run the API alone (the Vite dev server proxies to it).
STATIC_DIR=

# ------------------------------------------------------- model hub (optional)
# Hugging Face is not reachable from every network; use the mirror.
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_TELEMETRY=1
