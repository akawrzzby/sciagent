# ---------------------------------------------------------------------------
# SciAgent – environment configuration template
#
# Copy to `.env` and adjust.  NEVER commit the real `.env` file: it may contain
# API keys.  All values below are safe defaults for the competition setup.
#
# Every knob of `backend/app/core/config.py` appears here, so the template
# doubles as the environment reference of the technical document.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- application
APP_NAME=SciAgent
APP_VERSION=0.1.0
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
# Comma separated CORS origins ("*" allows all).
CORS_ORIGINS=*

# ------------------------------------------------------------------- storage
# Directory holding uploaded PDFs, rendered page images and parse artefacts.
DATA_DIR=./data
# SQLite metadata store (leave empty to use <DATA_DIR>/sciagent.db).
# DATABASE_URL=sqlite+aiosqlite:///./data/sciagent.db
# Vector index directory (one .npy matrix per paper).
INDEX_DIR=./data/index
# Where the prompt audit trail is persisted (the defence round asks for it).
AUDIT_DIR=./data/audit

# ----------------------------------------------------------------------- llm
# OpenAI-compatible endpoint of the local vLLM server (Qwen3.8-27B).
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen3.8-27B
# Optional: only needed when the endpoint requires authentication.
# LLM_API_KEY=
LLM_TIMEOUT=300
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
# How many documents may take part in one multi-paper reasoning call.
LLM_MAX_CONTEXT_PAPERS=12
# Self-feedback loop: how often the agent may search again and regenerate when
# the evidence it cites does not cover its own claims.
AGENT_MAX_REFINE_ROUNDS=2
# Reasoning channel switch (Qwen3 chat template "enable_thinking").
# The agent phase (router / planner / tool calling) keeps it on -- there the
# reasoning is what makes the tool sequence sensible, and it is streamed to
# the interface as the thinking panel.
LLM_THINKING=true
# The answer phase turns it off.  Measured on the GPU host: with reasoning on,
# a cross-paper prompt made the model spend the whole token budget before
# writing a single character of the answer; with it off the same answer needs
# 34 tokens instead of 166 and arrives in 0.8s instead of 4.2s.
LLM_ANSWER_THINKING=false

# ----------------------------------------------------------------- embedding
# Dense retriever (multilingual, 1024-dim) and cross-encoder reranker.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=512
# torch threads.  On a 192-core host the default (one thread per core)
# oversubscribes the machine and drops throughput from ~100 passages/s to ~7.
EMBEDDING_THREADS=64
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true
RERANKER_MAX_PASSAGES=24

# ---------------------------------------------------------------- retrieval
RETRIEVE_TOP_K_SPARSE=40
RETRIEVE_TOP_K_DENSE=40
RETRIEVE_TOP_K_FINAL=8
# Minimum fused score a passage needs before it may be used as evidence.
RETRIEVE_MIN_SCORE=0.0
# How much a paper's metadata (title / authors / year) lifts the score of its
# passages when the query names that paper.  0 disables the boost.
METADATA_BOOST=0.30
# Whether the metadata is carried into the dense vectors, into the
# cross-encoder input, or into both.  These switches exist so the effect of the
# metadata-aware retrieval can be measured instead of asserted.
METADATA_AWARE_EMBEDDING=true
METADATA_AWARE_RERANK=true

# ------------------------------------------------------------------- parsing
# DPI used when rasterising pages for OCR / formula transcription.
RENDER_DPI=150
PARSE_WORKERS=8
# 0 = unlimited; set a small number for smoke tests.
PARSE_MAX_PAGES=0

# --------------------------------------------------------------------- agent
AGENT_MAX_STEPS=8
AGENT_MAX_PARALLEL_TOOLS=4

# ------------------------------------------------------------------ security
# When API_KEY is set, clients must send the header `X-API-Key`.
# API_KEY=
REVIEWER_USER=reviewer
# REVIEWER_PASSWORD=

# ----------------------------------------------------------------- frontend
# Directory with the built frontend (frontend/dist).  When it is set, the same
# process serves the SPA and the API, so a public demo needs only one URL.
# Leave empty to run the API alone (the Vite dev server proxies to it).
STATIC_DIR=

# ------------------------------------------------------- model hub (optional)
# Hugging Face is not reachable from every network; use the mirror.
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_TELEMETRY=1

# --------------------------------------------------------- compose build args
# apt mirror: deb.debian.org measures ~350 KB/s from inside China and can stall
# the build outright; the TUNA mirror measures ~7.5 MB/s (21x faster).
# Outside China, switch both back to the official endpoints.
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
# pip mirror: the official PyPI index frequently times out behind the GFW.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Every runtime dependency ships a prebuilt manylinux wheel, so the compiler
# toolchain is not needed and would add ~570 MB to the image.  Set to true
# only when you add a dependency that has no wheel.
INSTALL_BUILD_DEPS=false
# Install torch(cpu) + sentence-transformers into the image (+2GB).
# false -> the backend degrades to pure BM25 sparse retrieval.
INSTALL_EMBEDDINGS=false
