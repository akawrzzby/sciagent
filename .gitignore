# ---- 环境变量与密钥 ----
# .env 绝不进版本库（含 API key / 数据库口令 / 评审账号密码）
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- Node / 前端 ----
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 运行时数据 ----
*.sqlite
*.sqlite3
*.db
data/
index/
models/
uploads/
logs/

# ---- 日志 ----
*.log
*.log.err
*.log.out

# ---- 编辑器 / IDE ----
.idea/
.vscode/
*.swp
*.swo

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 部署产物 ----
docker-compose.override.yml

# ---- 内部交接文档（含团队私人联系方式，只留本地）----
docs/HANDOFF.md

# ---- 一次性诊断脚本（读凭据 / 试 API，绝不入公开仓库）----
scripts/probe_*.py
scripts/push_workflow_via_api.py
scripts/try_api_routes.py

# ---- GitHub Actions 工作流 ----
# 当前 GitHub PAT 缺 workflow scope，GitHub 会拒绝 workflow 路径的写操作
# （git push 报 refusing to allow...without workflow scope，API 返回 404）。
# 因此文件只留在本地；等 PAT 补上 scope 后删掉这两行即可入库。
# 等价的可复现方案已在仓库内：scripts/ci_docker_test.sh
.github/
